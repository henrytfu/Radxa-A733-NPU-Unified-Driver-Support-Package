#!/bin/sh
set -e

# 1. Identify the NPU hardware address currently held by vipcore
# Usually looks like 'fb000000.npu'
NPU_ADDR=$(ls /sys/bus/platform/drivers/vipcore/ | grep -E '^[0-9a-f]+\.npu$|npu' | head -n 1)

if [ -n "$NPU_ADDR" ]; then
    echo "NPU hardware found at $NPU_ADDR. Unbinding from VIP-Lite (vipcore)..."
    echo "$NPU_ADDR" > /sys/bus/platform/drivers/vipcore/unbind || true
    echo on | sudo tee /sys/devices/platform/soc@3000000/3600000.npu/power/control
fi

# 2. Register the new module
echo "Updating module dependencies..."
depmod -a

# 3. Attempt to load the Unified driver
echo "Loading Unified Galcore driver..."
modprobe galcore || true

# 4. Success check
if [ -e /dev/galcore ]; then
    echo "Successfully initialized /dev/galcore"
else
    echo "Warning: /dev/galcore did not appear. Check dmesg."
fi

exit 0