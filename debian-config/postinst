#!/bin/sh
set -e

echo "Configuring NPU for Unified Driver..."

# 1. We need to make sure vipcore is loaded because it's needed to power on the NPU
# We then immediately unbind and unload it to allow galcore to take over
# galcore appears to not be able to power on the NPU by itself
modprobe vipcore || true
echo "Stopping existing vipcore driver..."
# Unbind hardware
for dev in /sys/bus/platform/drivers/vipcore/*.npu; do
    [ -e "$dev" ] && echo $(basename "$dev") > /sys/bus/platform/drivers/vipcore/unbind || true
done
# Remove module
rmmod vipcore || true

# 2. Setup module dependencies
depmod -a
modprobe galcore

systemctl daemon-reload
systemctl enable npu-prepare.service
systemctl start npu-prepare.service

# 5. Update initramfs (The "Nuclear" Option)
# This ensures vipcore is gone from the very first stage of boot
if command -v update-initramfs >/dev/null; then
    echo "Updating initramfs..."
    update-initramfs -u
fi

# 4. Success check
if [ -e /dev/galcore ]; then
    echo "Successfully initialized /dev/galcore"
else
    echo "Warning: /dev/galcore did not appear. Check dmesg."
fi

exit 0